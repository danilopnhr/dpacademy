/// Uma linha por despesa da cota parlamentar (arquivo anual da Câmara). Partido e UF são os publicados na linha da despesa.
table Despesas
	lineageTag: 897ddc84-d0db-535a-abc9-e779172e0335
	sourceLineageTag: [dbo].[fat_despesas]

	measure 'Gasto líquido' = SUM(Despesas[valor_liquido])
		formatString: R$ #,##0.00
		lineageTag: 1979e973-cc77-5f7b-9213-2b39740e7efc

	measure 'Valor do documento' = SUM(Despesas[valor_documento])
		formatString: R$ #,##0.00
		lineageTag: 70bce8dc-d22b-5a5e-9b48-0bad2745c332

	measure Glosa = SUM(Despesas[valor_glosa])
		formatString: R$ #,##0.00
		lineageTag: ba13073f-c0ae-56b4-a9e6-2d1722ad4d48

	measure 'Quantidade de despesas' = COUNTROWS(Despesas)
		formatString: #,##0
		lineageTag: 2dc9765e-677f-5ccc-9c12-52fcfc83c495

	measure 'Deputados com despesa' = CALCULATE(DISTINCTCOUNT(Despesas[sk_deputado]), Deputado[Tipo membro] = "Deputado")
		formatString: #,##0
		lineageTag: 014756fa-293d-5ee4-a8b4-6598fcad9f2f

	measure 'Gasto médio por deputado' = DIVIDE(CALCULATE([Gasto líquido], Deputado[Tipo membro] = "Deputado"), [Deputados com despesa])
		formatString: R$ #,##0.00
		lineageTag: f9b18a73-3dfe-5bcc-8e70-2f5228f30e3b

