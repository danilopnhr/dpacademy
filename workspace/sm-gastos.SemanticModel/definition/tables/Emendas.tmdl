/// Uma linha por emenda, tipo e localidade (Portal da Transparência). Emendas só têm ano: leia no nível de Ano do calendário.
table Emendas
	lineageTag: 4063262d-be0c-5654-9cce-92ebeed53ff8
	sourceLineageTag: [dbo].[fat_emendas]

	measure 'Emendas empenhado' = SUM(Emendas[valor_empenhado])
		formatString: R$ #,##0.00
		lineageTag: ccf55fb2-22cd-56ef-9ba9-50f3ad599e2a

	measure 'Emendas liquidado' = SUM(Emendas[valor_liquidado])
		formatString: R$ #,##0.00
		lineageTag: 05415b85-3823-5e17-94fe-efe6ff4fd5ad

	measure 'Emendas pago' = SUM(Emendas[valor_pago])
		formatString: R$ #,##0.00
		lineageTag: 1948a4e0-486a-58a2-86a9-6358f5f670bd

	measure 'Quantidade de emendas' = COUNTROWS(Emendas)
		formatString: #,##0
		lineageTag: a4e697f0-db10-5953-b6da-62b231000373

	measure 'Emendas individuais pago' = CALCULATE([Emendas pago], 'Tipo de emenda'[Grupo emenda] = "Individual")
		formatString: R$ #,##0.00
		lineageTag: b7bca7ef-8515-58cc-8f10-c7d60b08f940

	measure '% pago ligado a deputado' = DIVIDE(CALCULATE([Emendas individuais pago], 'Autor da emenda'[Ligado a deputado] = TRUE()), [Emendas individuais pago])
		formatString: 0.0%
		lineageTag: ccfe58ca-cc60-5a25-ab4c-81dddbdbbaf4

	measure 'Individuais 2022 para 2023' =
			VAR antes = CALCULATE([Emendas individuais pago], REMOVEFILTERS('Calendário'), 'Calendário'[Ano] = 2022)
			VAR depois = CALCULATE([Emendas individuais pago], REMOVEFILTERS('Calendário'), 'Calendário'[Ano] = 2023)
			RETURN IF(NOT ISBLANK(antes), DIVIDE(depois, antes) - 1)
		formatString: +0%;-0%;0%
		displayFolder: Página Emendas
		lineageTag: 28fbc20a-aa26-5bc9-bafa-52b4a850ad70

	measure 'Deputados com emenda individual ligada' =
			VAR a = [Último ano completo]
			RETURN CALCULATE(DISTINCTCOUNT(Emendas[sk_deputado]), REMOVEFILTERS('Calendário'), 'Calendário'[Ano] = a, 'Tipo de emenda'[Grupo emenda] = "Individual", Emendas[sk_deputado] > 0)
		formatString: #,##0
		displayFolder: Página Emendas
		lineageTag: 78d9cf32-14ca-5ba1-a5f4-799903223b3e

	measure 'Emendas individuais por real de cota' =
			VAR a = [Último ano completo]
			VAR deps = CALCULATETABLE(VALUES(Emendas[sk_deputado]), REMOVEFILTERS('Calendário'), 'Calendário'[Ano] = a, 'Tipo de emenda'[Grupo emenda] = "Individual", Emendas[sk_deputado] > 0)
			VAR em = CALCULATE([Emendas individuais pago], REMOVEFILTERS('Calendário'), 'Calendário'[Ano] = a, TREATAS(deps, Deputado[sk_deputado]))
			VAR cota = CALCULATE([Gasto líquido], REMOVEFILTERS('Calendário'), 'Calendário'[Ano] = a, TREATAS(deps, Deputado[sk_deputado]))
			RETURN DIVIDE(em, cota)
		formatString: R$ #,##0
		displayFolder: Página Emendas
		lineageTag: eaed30d3-faeb-53ac-a68c-56ed672a18e5

	measure 'Texto do recorte por real de cota' =
			VAR a = [Último ano completo]
			VAR n = [Deputados com emenda individual ligada]
			RETURN IF(NOT ISBLANK(n), "Em " & FORMAT(a, "0") & ", entre os " & FORMAT(n, "#,##0") & " deputados com emenda individual ligada.")
		displayFolder: Página Emendas
		lineageTag: e6508d6d-27cc-5cbc-a6ba-e5b61c8ccccc

	measure 'Participação da Saúde' =
			VAR a = [Último ano completo]
			VAR total = CALCULATE([Emendas pago], REMOVEFILTERS('Calendário'), 'Calendário'[Ano] >= a - 2 && 'Calendário'[Ano] <= a, REMOVEFILTERS('Função'))
			VAR saude = CALCULATE([Emendas pago], REMOVEFILTERS('Calendário'), 'Calendário'[Ano] >= a - 2 && 'Calendário'[Ano] <= a, 'Função'[Função] = "Saúde")
			RETURN DIVIDE(saude, total)
		formatString: 0%
		displayFolder: Página Emendas
		lineageTag: 1cab36f0-f25f-577a-ab36-d556e41438b6

	measure 'Texto da janela de três anos' =
			VAR a = [Último ano completo]
			RETURN IF(NOT ISBLANK(a), FORMAT(a - 2, "0") & "–" & FORMAT(a, "0"))
		displayFolder: Página Emendas
		lineageTag: 527610d4-9d85-54c2-a3a6-e18cfed69be9

